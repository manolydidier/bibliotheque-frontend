# Utilisé uniquement pour "npm run build" (mode production).
# Toutes les valeurs sont des chemins RELATIFS : le navigateur les résout
# contre https://miradia.mg, donc tout reste en HTTPS et passe par le
# reverse proxy Nginx qui redirige vers le VPS (84.247.182.163:8000) en interne.
# Ne jamais remettre une URL http://84.247.182.163:8000/... ici.

VITE_API_BASE_URL=/api
VITE_API_BASE_STORAGE=/
VITE_DEBUG_SHARE=false
VITE_DEBUG_HTTP=false

VITE_FILE_PROXY=/api/file-proxy?url=

# Le viewer PDF.js est copié dans public/pdfjs au build (script postinstall
# "pdfjs:copy"), donc il est servi directement par miradia.mg, pas par le VPS.
VITE_PDFJS_VIEWER=/pdfjs/web/viewer.html?file=
